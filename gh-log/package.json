{
  "name": "gh-log",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "gh-log": "./dist/cli.js",
    "gh-log-chunk": "./dist/cli-chunk.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx --env-file-if-exists=.env src/cli.ts",
    "dev:chunk": "tsx --env-file-if-exists=.env src/cli-chunk.ts",
    "log": "node --env-file-if-exists=.env dist/cli.js",
    "chunk": "node --env-file-if-exists=.env dist/cli-chunk.js"
  },
  "dependencies": {
    "octokit": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19",
    "typescript": "^5.8"
  }
}
