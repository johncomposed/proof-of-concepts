{
  "name": "gh-log",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "gh-log": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx --env-file-if-exists=.env src/cli.ts",
    "start": "node --env-file-if-exists=.env dist/cli.js",
    "log": "tsx --env-file-if-exists=.env src/cli.ts log",
    "chunk": "tsx --env-file-if-exists=.env src/cli.ts chunk"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "octokit": "^4.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19",
    "typescript": "^5.8"
  }
}
